---
const pl = Astro.currentLocale === "pl";
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + (pl ? "/pl" : "");

const t = pl
  ? { once: "Raz na projekt", per: "Dla każdej funkcji", writes: "zapisuje" }
  : { once: "Once per project", per: "Per feature", writes: "writes" };

const steps = [
  { cmd: "doctor", show: "/sdd:doctor init", en: ["Init", "Bootstraps specs/, detects projects"], pl: ["Init", "Tworzy specs/, wykrywa projekty"], writes: "specs/" },
  { cmd: "constitution", en: ["Constitution", "Stack, rules and WHAT NOT TO DO"], pl: ["Constitution", "Stack, reguły i WHAT NOT TO DO"], writes: "constitution.md" },
  { cmd: "spec", en: ["Specify", "Branch and a business-only spec"], pl: ["Specify", "Gałąź i spec wyłącznie biznesowy"], writes: "spec.md" },
  { cmd: "clarify", en: ["Clarify", "Up to 5 questions with proposed answers"], pl: ["Clarify", "Do 5 pytań z proponowanymi odpowiedziami"], writes: "spec.md" },
  { cmd: "plan", en: ["Plan", "Decisions, scope and risks, in Plan Mode"], pl: ["Plan", "Decyzje, zakres i ryzyka, w Plan Mode"], writes: "plan.md" },
  { cmd: "tasks", en: ["Tasks", "Self-contained, Jira-like tickets"], pl: ["Tasks", "Samodzielne tickety w stylu Jiry"], writes: "tasks.md" },
  { cmd: "implement", en: ["Implement", "Hand-off to your own flow"], pl: ["Implement", "Przekazanie do Twojego flow"], writes: pl ? "commity" : "commits" },
  { cmd: "review", en: ["Review", "Verdict: READY or NOT READY"], pl: ["Review", "Werdykt: READY lub NOT READY"], writes: "review.md" },
].map((s) => ({ ...s, show: s.show ?? `/sdd:${s.cmd}`, label: (pl ? s.pl : s.en)[0], note: (pl ? s.pl : s.en)[1] }));

const groups = [
  { title: t.once, items: steps.slice(0, 2), offset: 0 },
  { title: t.per, items: steps.slice(2), offset: 2 },
];
---

<div class="flow">
  {
    groups.map((g) => (
      <section class="group">
        <h3 class="group-title">{g.title}</h3>
        <ol start={g.offset + 1}>
          {g.items.map((s, i) => (
            <li>
              <a href={`${base}/commands/${s.cmd}/`}>
                <span class="node" aria-hidden="true">{g.offset + i + 1}</span>
                <span class="title">
                  <span class="label">{s.label}</span>
                  <code>{s.show}</code>
                </span>
                <span class="note">{s.note}</span>
                <span class="writes">
                  <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                    <path d="M4 1.75h5l3 3v9.5H4zM9 1.75v3h3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                  </svg>
                  <span class="sr-only">{t.writes} </span>{s.writes}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  /* Starlight prose adds margin-top between siblings; the component spaces itself */
  .flow :is(section, h3, ol, li, span, code, svg) {
    margin-top: 0 !important;
  }
  .flow {
    display: grid;
    gap: 1.75rem;
    margin: 1.75rem 0 0;
  }
  .group-title {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 0.5rem;
    font-family: var(--sl-font);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .group-title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--sl-color-hairline-shade);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    position: relative;
    margin: 0;
    padding: 0;
  }
  /* connector running through the nodes */
  li::before {
    content: "";
    position: absolute;
    left: calc(0.75rem + 1.125rem - 1px);
    top: 0;
    bottom: 0;
    width: 2px;
    background: color-mix(in srgb, var(--sl-color-accent) 30%, var(--sl-color-gray-5));
  }
  li:first-child::before {
    top: 1.925rem;
  }
  li:last-child::before {
    display: none;
  }
  li:only-child::before {
    display: none;
  }

  a {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    grid-template-areas:
      "node title"
      ". note"
      ". writes";
    column-gap: 1rem;
    row-gap: 0.25rem;
    align-items: center;
    padding: 0.8rem 0.75rem;
    border-radius: 0.625rem;
    color: var(--sl-color-white);
    text-decoration: none;
    transition: background-color 0.15s;
  }
  a:hover,
  a:focus-visible {
    background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
  }
  a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }

  .node {
    grid-area: node;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--sl-color-accent-low);
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    box-shadow: 0 0 0 4px var(--sl-color-black);
    color: var(--sl-color-accent-high);
    font-weight: 700;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  a:hover .node,
  a:focus-visible .node {
    background: var(--brand);
    color: #fff;
    border-color: var(--brand);
  }

  .title {
    grid-area: title;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.75rem;
    min-width: 0;
  }
  .label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .flow .title code {
    background: none;
    border: 0;
    padding: 0;
    color: var(--sl-color-text-accent);
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .note {
    grid-area: note;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }
  .writes {
    grid-area: writes;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 999px;
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
  .writes svg {
    flex: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  a:hover .writes,
  a:focus-visible .writes {
    border-color: color-mix(in srgb, var(--sl-color-accent) 50%, transparent);
    color: var(--sl-color-text-accent);
  }
  .writes {
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  a:active .node {
    scale: 0.94;
  }
  .node {
    transition:
      background-color 0.15s,
      color 0.15s,
      scale 0.15s;
  }

  /* One row per phase: node, name and command, what it does, file it writes */
  @media (min-width: 44rem) {
    a {
      grid-template-columns: 2.25rem 15rem minmax(0, 1fr) 8.5rem;
      grid-template-areas: "node title note writes";
      column-gap: 1.25rem;
    }
    li:first-child::before {
      top: 50%;
    }
    li:last-child::before {
      display: block;
      bottom: 50%;
    }
    li:only-child::before {
      display: none;
    }
    .title {
      flex-direction: column;
      gap: 0.1rem;
    }
    .writes {
      justify-self: end;
    }
  }
</style>
