---
import { LinkButton } from "@astrojs/starlight/components";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

const pl = Astro.currentLocale === "pl";
const t = pl
  ? {
      stage: "Przykładowa sesja: funkcja resetu hasła",
      install: "Zainstaluj w Claude Code",
      copy: "Kopiuj",
      copied: "Skopiowano",
      copyLabel: "Skopiuj komendy instalacji",
    }
  : {
      stage: "Example session: a password-reset feature",
      install: "Install in Claude Code",
      copy: "Copy",
      copied: "Copied",
      copyLabel: "Copy install commands",
    };

type Kind = "draft" | "ready" | "progress" | "done";
interface Line {
  cmd: string;
  arg?: string;
  out: string;
  pill: string;
  kind: Kind;
}
const lines: Line[] = pl
  ? [
      { cmd: "/sdd:spec", arg: "feat user can reset password via email", out: "gałąź feat/password-reset, spec.md", pill: "draft", kind: "draft" },
      { cmd: "/sdd:clarify", out: "3 pytania zamknięte", pill: "clarified", kind: "ready" },
      { cmd: "/sdd:plan", out: "plan.md zatwierdzony w Plan Mode", pill: "planned", kind: "ready" },
      { cmd: "/sdd:tasks", out: "tasks.md, 5 zadań", pill: "tasks-ready", kind: "ready" },
      { cmd: "/sdd:implement", arg: "all", out: "T1 do T5 zaimplementowane", pill: "in-progress", kind: "progress" },
      { cmd: "/sdd:review", out: "READY, 12 z 12 kryteriów spełnionych", pill: "done", kind: "done" },
    ]
  : [
      { cmd: "/sdd:spec", arg: "feat user can reset password via email", out: "branch feat/password-reset, spec.md", pill: "draft", kind: "draft" },
      { cmd: "/sdd:clarify", out: "3 questions closed", pill: "clarified", kind: "ready" },
      { cmd: "/sdd:plan", out: "plan.md approved in Plan Mode", pill: "planned", kind: "ready" },
      { cmd: "/sdd:tasks", out: "tasks.md, 5 tasks", pill: "tasks-ready", kind: "ready" },
      { cmd: "/sdd:implement", arg: "all", out: "T1 to T5 implemented", pill: "in-progress", kind: "progress" },
      { cmd: "/sdd:review", out: "READY, 12 of 12 criteria met", pill: "done", kind: "done" },
    ];

const installCmd = "/plugin marketplace add JanSzewczyk/spec-driven-development\n/plugin install sdd@spec-driven-development";
---

<div class="hero">
  <div class="copy">
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ))}
        </div>
      )
    }
    <div class="install">
      <span class="install-label">{t.install}</span>
      <div class="install-box">
        <pre><code>{installCmd}</code></pre>
        <button type="button" class="copy-btn" data-text={installCmd} data-copied={t.copied} aria-label={t.copyLabel}>{t.copy}</button>
      </div>
    </div>
  </div>

  <figure class="stage" aria-label={t.stage}>
    <div class="bar" aria-hidden="true">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="path">specs/password-reset/</span>
    </div>
    <ol class="log">
      {
        lines.map((l, i) => (
          <li style={`--i:${i}`}>
            <p class="cmd">
              <span class="prompt" aria-hidden="true">&gt;</span>
              <b>{l.cmd}</b>
              {l.arg && <span class="arg">{l.arg}</span>}
            </p>
            <p class="res">
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="m3.5 8.5 3 3 6-7" pathLength="1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="out">{l.out}</span>
              <span class="pill" data-kind={l.kind}>{l.pill}</span>
            </p>
          </li>
        ))
      }
    </ol>
  </figure>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>(".hero .copy-btn").forEach((btn) => {
    const label = btn.textContent;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.text ?? "");
        btn.textContent = btn.dataset.copied ?? "";
        btn.dataset.state = "done";
        setTimeout(() => {
          btn.textContent = label;
          delete btn.dataset.state;
        }, 1800);
      } catch {
        /* clipboard blocked: the text stays selectable */
      }
    });
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
    padding-block: clamp(1.5rem, 4vw, 3rem) 1rem;
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 28.5rem);
      gap: 3.5rem;
      padding-block: clamp(2.5rem, 7vh, 5rem) 2rem;
    }
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    min-width: 0;
  }
  h1 {
    margin: 0;
    max-width: 16ch;
  }
  .tagline {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.2rem);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 0.25rem;
  }

  /* Install */
  .install {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.4rem;
    width: 100%;
    max-width: 34rem;
    margin-top: 0.75rem;
  }
  .install-label {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--sl-color-gray-3);
  }
  .install-box {
    position: relative;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-7);
  }
  .install-box pre {
    margin: 0;
    padding: 0.8rem 5.25rem 0.8rem 1rem;
    overflow-x: auto;
    font-size: 0.8rem;
    line-height: 1.7;
    background: none;
    border: 0;
  }
  .install-box code {
    background: none;
    border: 0;
    padding: 0;
    color: var(--sl-color-gray-1);
  }
  .copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    min-height: 2rem;
    padding: 0 0.7rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 0.375rem;
    background: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  .copy-btn:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-text-accent);
  }
  .copy-btn:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .copy-btn[data-state="done"] {
    border-color: var(--sl-color-green);
    color: var(--sl-color-green-high);
  }

  /* Stage: a terminal that is dark in both themes */
  .stage {
    --t-bg: #0b0e15;
    --t-line: #1e2535;
    --t-text: #e5e7eb;
    --t-dim: #9ca3af;
    --t-cmd: #93c5fd;
    margin: 0;
    min-width: 0;
    border: 1px solid var(--t-line);
    border-radius: 0.75rem;
    background: var(--t-bg);
    color: var(--t-text);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.04) inset,
      0 28px 56px -28px rgb(37 99 235 / 0.45),
      0 8px 20px -12px rgb(0 0 0 / 0.5);
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--t-line);
    background: #0f1320;
  }
  .dots {
    display: inline-flex;
    gap: 0.4rem;
  }
  .dots i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #2a3246;
  }
  .path {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--t-dim);
  }
  .log {
    list-style: none;
    margin: 0;
    padding: 1.1rem 1.1rem 1.25rem;
    display: grid;
    gap: 0.95rem;
    font-family: var(--sl-font-mono);
  }
  .log li {
    margin: 0;
    display: grid;
    gap: 0.3rem;
  }
  .log p {
    margin: 0;
  }
  .cmd {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    font-size: 0.8rem;
    line-height: 1.55;
  }
  .prompt {
    color: var(--t-dim);
  }
  .cmd b {
    font-weight: 600;
    color: var(--t-cmd);
  }
  .arg {
    color: var(--t-text);
    overflow-wrap: anywhere;
  }
  .res {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.55rem;
    padding-inline-start: 1.1rem;
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--t-dim);
  }
  .res svg {
    flex: none;
    color: #34d399;
  }
  .out {
    min-width: 0;
  }
  .pill {
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--c) 38%, transparent);
  }
  .pill[data-kind="draft"] {
    --c: #a3a3a3;
  }
  .pill[data-kind="ready"] {
    --c: #60a5fa;
  }
  .pill[data-kind="progress"] {
    --c: #fbbf24;
  }
  .pill[data-kind="done"] {
    --c: #34d399;
  }

  .copy-btn:active {
    transform: scale(0.97);
  }
  .res svg path {
    stroke-dasharray: 1;
  }

  /* One authored moment: the copy settles in, then the session writes itself line by line.
     Each line is a beat: command, then the check draws, then the status pill lands. */
  @media (prefers-reduced-motion: no-preference) {
    .copy > * {
      animation: rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--k, 0) * 0.07s);
    }
    .copy > :nth-child(2) {
      --k: 1;
    }
    .copy > :nth-child(3) {
      --k: 2;
    }
    .copy > :nth-child(4) {
      --k: 3;
    }
    .stage {
      animation: rise 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.12s both;
    }
    .log li {
      --d: calc(0.6s + var(--i) * 0.46s);
    }
    .log .cmd {
      animation: rise 0.5s cubic-bezier(0.16, 1, 0.3, 1) var(--d) both;
    }
    .log .res {
      animation: fade 0.3s ease-out calc(var(--d) + 0.22s) both;
    }
    .res svg path {
      animation: draw 0.35s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--d) + 0.26s) both;
    }
    .pill {
      transform-origin: left center;
      animation: pop 0.4s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--d) + 0.4s) both;
    }
    .log li:last-child .pill {
      animation:
        pop 0.4s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--d) + 0.4s) both,
        ping 1.1s ease-out calc(var(--d) + 0.55s) 1 both;
    }
    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
    }
    @keyframes fade {
      from {
        opacity: 0;
      }
    }
    @keyframes draw {
      from {
        stroke-dashoffset: 1;
      }
      to {
        stroke-dashoffset: 0;
      }
    }
    @keyframes pop {
      from {
        opacity: 0;
        transform: scale(0.85);
      }
    }
    @keyframes ping {
      from {
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--c) 45%, transparent);
      }
      to {
        box-shadow: 0 0 0 9px transparent;
      }
    }
  }
</style>
