---
const pl = Astro.currentLocale === "pl";
const t = pl
  ? { setup: "setup, spec, clarify, plan", human: "Człowiek recenzuje plan.md", impl: "/sdd:implement T1", ask: "flow skonfigurowany?", yes: "tak", no: "nie", hand: "Przekaż zadanie do skonfigurowanego flow", ses: "Zaimplementuj w sesji", ver: "spec-verifier + reviewer + Twoje sprawdzenia", ready: "READY", notReady: "NOT READY", ship: "commit + PR", retro: "opcjonalnie", back: "wraca do /sdd:implement" }
  : { setup: "setup, spec, clarify, plan", human: "Human reviews plan.md", impl: "/sdd:implement T1", ask: "flow configured?", yes: "yes", no: "no", hand: "Hand the task to the configured flow", ses: "Implement in the session", ver: "spec-verifier + reviewer + your checks", ready: "READY", notReady: "NOT READY", ship: "commit + PR", retro: "optional", back: "back to /sdd:implement" };
---

<div class="fx">
  <div class="fx-col">
    <div class="fx-node fx-cmd"><code>/sdd:doctor … /sdd:plan</code><small>{t.setup}</small></div>
    <div class="fx-down"></div>
    <div class="fx-node fx-human"><b>{t.human}</b></div>
    <div class="fx-down"></div>
    <div class="fx-node fx-cmd"><code>/sdd:tasks</code></div>
    <div class="fx-down"></div>
    <div class="fx-node fx-cmd"><code>{t.impl}</code><small>{t.ask}</small></div>
    <div class="fx-down"></div>
    <div class="fx-row">
      <div class="fx-node"><span class="fx-tag">{t.yes}</span><b>{t.hand}</b></div>
      <div class="fx-node"><span class="fx-tag">{t.no}</span><b>{t.ses}</b></div>
    </div>
    <div class="fx-down"></div>
    <div class="fx-node fx-cmd"><code>/sdd:review</code><small>{t.ver}</small></div>
    <div class="fx-down"></div>
    <div class="fx-row">
      <div class="fx-node fx-ok">
        <span class="fx-tag">{t.ready}</span><b>{t.ship}</b><small><code>/sdd:retro</code> · {t.retro}</small>
      </div>
      <div class="fx-node fx-bad"><span class="fx-tag">{t.notReady}</span><small>{t.back}</small></div>
    </div>
  </div>
</div>
