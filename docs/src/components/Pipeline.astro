---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const steps = [
  { cmd: "constitution", label: "Constitution", note: "Stack, rules and WHAT NOT TO DO", href: "/commands/constitution/" },
  { cmd: "spec", label: "Specify", note: "Branch and a business-only spec", href: "/commands/spec/" },
  { cmd: "clarify", label: "Clarify", note: "Up to 5 questions with proposed answers", href: "/commands/clarify/" },
  { cmd: "plan", label: "Plan", note: "Decisions, scope and risks, in Plan Mode", href: "/commands/plan/" },
  { cmd: "tasks", label: "Tasks", note: "Self-contained, Jira-like tickets", href: "/commands/tasks/" },
  { cmd: "implement", label: "Implement", note: "Hand-off to your own flow", href: "/commands/implement/" },
  { cmd: "review", label: "Review", note: "Verdict: READY or NOT READY", href: "/commands/review/" },
];
---

<ol class:list={["pipeline", { compact }]}>
  {
    steps.map((s, i) => (
      <li>
        <a href={base + s.href}>
          <span class="n" aria-hidden="true">{i + 1}</span>
          <span class="label">{s.label}</span>
          {!compact && <code>/sdd:{s.cmd}</code>}
          {!compact && <span class="note">{s.note}</span>}
        </a>
      </li>
    ))
  }
</ol>

<style>
  .pipeline {
    list-style: none;
    margin: 1.5rem 0;
    padding: 0;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.875rem;
    overflow: hidden;
    background: var(--sl-color-gray-7);
  }
  :global(:root[data-theme="light"]) .pipeline {
    background: #fff;
  }
  li {
    margin: 0;
    padding: 0;
  }
  li + li {
    border-top: 1px solid var(--sl-color-hairline);
  }
  a {
    display: grid;
    grid-template-columns: 1.75rem 7.5rem 9.5rem 1fr;
    align-items: baseline;
    column-gap: 0.75rem;
    padding: 0.7rem 1rem;
    color: var(--sl-color-white);
    text-decoration: none;
    transition: background-color 0.15s;
  }
  a:hover,
  a:focus-visible {
    background: var(--sl-color-gray-6);
  }
  .n {
    justify-self: start;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-size: 0.78rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    align-self: center;
  }
  .label {
    font-weight: 600;
  }
  code {
    color: var(--sl-color-text-accent);
    background: none;
    border: 0;
    padding: 0;
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .note {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  /* Compact: one wrapping row of chips */
  .compact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    border: 0;
    border-radius: 0;
    background: none;
    overflow: visible;
  }
  :global(:root[data-theme="light"]) .compact {
    background: none;
  }
  .compact li + li {
    border: 0;
  }
  .compact a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.75rem 0.3rem 0.4rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    background: var(--sl-color-gray-7);
  }
  :global(:root[data-theme="light"]) .compact a {
    background: #fff;
  }
  .compact a:hover {
    border-color: var(--sl-color-accent);
  }

  @media (max-width: 40rem) {
    a {
      grid-template-columns: 1.75rem 1fr;
      row-gap: 0.1rem;
    }
    code,
    .note {
      grid-column: 2;
    }
  }
</style>
