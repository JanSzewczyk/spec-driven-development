{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/JanSzewczyk/spec-driven-development/main/plugins/sdd/schemas/capabilities.schema.json",
  "title": "SDD capabilities (specs/capabilities.yml)",
  "description": "Configuration of the Spec-Driven Development flow. Reference: plugins/sdd/references/capabilities.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": { "description": "Artifact format version; /sdd:doctor init migrates a lower one. The value is the current format.", "type": "integer", "const": 3 },
    "projects": {
      "description": "Rewritten by /sdd:doctor init. One entry per project.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" },
          "path": { "description": "Relative to the repo root; `.` for the root.", "type": "string" },
          "stack": { "type": "string" },
          "repo": { "description": "A sibling repository checked out next to this one.", "type": "boolean" }
        }
      }
    },
    "implementation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "default": { "description": "Who implements a task when no project line matches.", "$ref": "#/$defs/flow", "default": "in-session" },
        "projects": { "description": "Who implements a task, per project.", "type": ["object", "null"], "additionalProperties": { "$ref": "#/$defs/flow" } },
        "isolation": {
          "description": "none: this session implements and commits every task. worktree: each task in its own sub-session, worktree and branch.",
          "oneOf": [
            { "type": "null" },
            { "enum": ["none"] },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["worktree"],
              "properties": {
                "worktree": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "properties": {
                    "merge": { "description": "pr: a PR per task, a human merges. auto: rebase + fast-forward.", "enum": ["pr", "auto"], "default": "pr" },
                    "parallel": { "description": "Tasks running at once.", "type": ["integer", "string"], "pattern": "^[1-9]\\d*$", "minimum": 1, "default": 3 }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "actions": {
      "description": "Who runs a git action; null: the session uses git and gh.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "branch": { "$ref": "#/$defs/action" },
        "commit": { "$ref": "#/$defs/action" },
        "pr": { "$ref": "#/$defs/action" }
      }
    },
    "review": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "tests": { "description": "Run the test suite in /sdd:review.", "enum": ["run", "skip", null], "default": "run" },
        "publish": { "description": "ask: confirm the commit and PR after READY. off: neither.", "enum": ["ask", "off", null], "default": "ask" },
        "default": { "description": "Audit flow: auto picks skills by stack.", "type": ["string", "null"], "pattern": "^(?:auto|(?:skill|agent):\\S.*)$", "default": "auto" },
        "projects": { "description": "Audit flow per project.", "type": ["object", "null"], "additionalProperties": { "$ref": "#/$defs/skillOrAgent" } },
        "checks": { "description": "Run on every review; an agent returns PASS | FAIL | SKIPPED.", "type": ["array", "null"], "items": { "$ref": "#/$defs/skillOrAgent" } },
        "ci": { "description": "Whether .github/workflows/sdd-check.yml is wanted.", "enum": ["on", "off", null] }
      }
    },
    "generated": {
      "description": "Globs left out of every diff and never flagged.",
      "type": ["array", "null"],
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "flow": { "type": ["string", "null"], "pattern": "^(?:(?:skill|agent|command):\\S.*|in-session)$" },
    "action": { "type": ["string", "null"], "pattern": "^(?:skill|agent|command):\\S" },
    "skillOrAgent": { "type": "string", "pattern": "^(?:skill|agent):\\S" }
  }
}
